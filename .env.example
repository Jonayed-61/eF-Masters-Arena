DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Explicit one-time bootstrap command: npm run admin:bootstrap
INITIAL_SUPER_ADMIN_EMAIL=""
INITIAL_SUPER_ADMIN_USERNAME=""
INITIAL_SUPER_ADMIN_PASSWORD=""

# Local development storage. Use an object-storage implementation in production.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIRECTORY="public/uploads"
STORAGE_PUBLIC_BASE_URL="/uploads"
